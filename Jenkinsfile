
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Connected to GitHub successfully!'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Risk Aware Development Pipeline...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running application tests...'
            }
        }

        stage('Complete') {
            steps {
                echo 'Pipeline executed successfully!'
            }
        }
    }
}
